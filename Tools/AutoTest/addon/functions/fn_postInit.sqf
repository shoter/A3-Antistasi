/*
    Entry point of the test harness, runs on the dedicated server only.
    Waits for the Antistasi setup monitor, starts the campaign described in run_config.sqf
    (generated by launch_tests.ps1), waits for server init and runs the selected tests.

    Maintainer: Shoter
*/
if (!isServer || !isDedicated) exitWith {};

[] spawn {
    private _cfg = call compile preprocessFileLineNumbers "\x\A3A_autotest\run_config.sqf";
    A3A_test_config = _cfg;
    ["PHASE", ["postInit", worldName, missionName, _cfg get "runId"]] call A3A_test_fnc_log;

    // Setup monitor publishes A3A_startupState right before it starts waiting for an admin
    private _t0 = diag_tickTime;
    waitUntil { sleep 1; !isNil "A3A_startupState" || diag_tickTime - _t0 > 600 };
    if (isNil "A3A_startupState") exitWith {
        ["FATAL", ["Antistasi setup monitor did not start within 600 s"]] call A3A_test_fnc_log;
    };
    ["PHASE", ["setupMonitor", A3A_startupState]] call A3A_test_fnc_log;

    if !([_cfg] call A3A_test_fnc_startCampaign) exitWith {};

    private _initTimeout = _cfg getOrDefault ["initTimeout", 1200];
    _t0 = diag_tickTime;
    private _lastState = "";
    waitUntil {
        sleep 1;
        if (!isNil "A3A_startupState" && {A3A_startupState isNotEqualTo _lastState}) then {
            _lastState = A3A_startupState;
            ["PHASE", ["startupState", _lastState]] call A3A_test_fnc_log;
        };
        !isNil "serverInitDone" || diag_tickTime - _t0 > _initTimeout
    };
    if (isNil "serverInitDone") exitWith {
        ["FATAL", [format ["serverInitDone not set within %1 s, startup state '%2'", _initTimeout, _lastState]]] call A3A_test_fnc_log;
    };
    ["PHASE", ["serverInitDone", round (diag_tickTime - _t0)]] call A3A_test_fnc_log;

    // Let the post-init loops (garrison spawning, AI director) take their first steps
    private _settle = _cfg getOrDefault ["settleSeconds", 15];
    if (_settle > 0) then {
        ["PHASE", ["settling", _settle]] call A3A_test_fnc_log;
        sleep _settle;
    };

    [_cfg get "tests"] call A3A_test_fnc_runTests;
};
